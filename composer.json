{
    "name": "tuijncode/html",
    "description": "HTML and Form Builders for the Laravel Framework",
    "license": "MIT",
    "homepage": "https://github.com/tuijncode/html",
    "support": {
        "issues": "https://github.com/tuijncode/html/issues",
        "source": "https://github.com/tuijncode/html"
    },
    "authors": [
        {
            "name": "Adam Engebretson",
            "email": "adam@laravelcollective.com"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylorotwell@gmail.com"
        },
        {
            "name": "David van der Tuijn",
            "email": "david@tuijncode.com"
        }
    ],
    "require": {
        "php": "^8.2",
    },
    "autoload": {
        "psr-4": {
            "Tuijncode\\Html\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tuijncode\\Html\\HtmlServiceProvider"
            ],
            "aliases": {
                "Form": "Tuijncode\\Html\\FormFacade",
                "Html": "Tuijncode\\Html\\HtmlFacade"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
